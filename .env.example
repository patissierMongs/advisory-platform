# 운영 기본값: 샘플 seed/feed 자동 적재 없음
ADVISORY_SEED=false
ADVISORY_BUNDLED_FEEDS=false

# ── 관리자 로그인 ──────────────────────────────────────────────────────────
# 최초 기동 시 로그인 가능한 관리자가 없으면 1명 생성한다(이후 기동에서는 아무 것도 하지 않음).
# 비밀번호를 비워 두면 무작위 생성 후 콘솔에 1회만 출력된다 — start.bat 창에서 확인할 것.
# 어느 경우든 최초 로그인 시 비밀번호 변경이 강제된다.
ADVISORY_BOOTSTRAP_ADMIN=admin
# ADVISORY_BOOTSTRAP_PASSWORD=

# 세션 수명(시간) / 유휴 만료(분)
ADVISORY_SESSION_HOURS=12
ADVISORY_SESSION_IDLE_MINUTES=60
# HTTPS 로 서비스할 때만 true. 폐쇄망 HTTP 배포에서 true 로 두면 쿠키가 전송되지 않아 로그인이 안 된다.
ADVISORY_SESSION_COOKIE_SECURE=false

# 로그인 실패 잠금
ADVISORY_LOGIN_MAX_FAILS=5
ADVISORY_LOGIN_LOCKOUT_MINUTES=15

# CORS — 비워 두면 동일 출처 전용(권장). 쿠키 인증과 '*' 는 함께 쓸 수 없어 기동이 거부된다.
# ADVISORY_CORS_ORIGINS=http://intranet.example

# 그룹웨어 ack 웹훅 HMAC 공유 시크릿. 미설정이면 해당 엔드포인트는 503 으로 닫힌다.
# 호출 규약: X-Advisory-Timestamp(unix초) + X-Advisory-Signature: sha256=<hex>
#            서명 대상 = "{timestamp}." + 요청 본문 원문
# ADVISORY_WEBHOOK_SECRET=change-me

# SQLite 파일 위치를 바꿔야 할 때만 지정
# ADVISORY_DATA_DIR=C:\advisory-platform-data
# ADVISORY_DATABASE_URL=sqlite:///C:/advisory-platform-data/advisory.db

# SMTP 메일 발송
ADVISORY_MAIL_ENABLED=true
ADVISORY_MAIL_SMTP_HOST=smtp.internal.example
ADVISORY_MAIL_SMTP_PORT=25
ADVISORY_MAIL_USE_TLS=false
ADVISORY_MAIL_FROM=security-advisory@example.go.kr

# 인증이 필요한 SMTP일 때만 설정
# ADVISORY_MAIL_SMTP_USER=security-advisory@example.go.kr
# ADVISORY_MAIL_SMTP_PASSWORD=change-me

# 선택 채널
ADVISORY_MESSENGER_ENABLED=false
ADVISORY_GROUPWARE_ENABLED=false

# 업로드 제한
ADVISORY_MAX_UPLOAD_MB=30
